# ─────────────────────────────────────────────────────────
# VOTEX — Environment Variables
# Copy this to .env.local (never commit .env.local to git)
# ─────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────
# Local PostgreSQL:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/votex?schema=public"
# Neon (cloud, recommended for Vercel):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.neon.tech/votex?sslmode=require"

# ── Auth / JWT ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_64_byte_random_hex_string"
JWT_EXPIRES_IN="7d"

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Email (optional — for OTP sending) ─────────────────
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@email.com"
# SMTP_PASS="your_app_password"
# EMAIL_FROM="VOTEX <noreply@votex.io>"
