// prisma/schema.prisma
// Prisma 7 — datasource has NO url property.
// Connection is configured in prisma.config.ts instead.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  VOTER
  CANDIDATE
  PARTY_ADMIN
}

enum ElectionType {
  PRESIDENTIAL
  PARLIAMENTARY
  MUNICIPAL
  SENATE
  CORPORATE
  STUDENT
  OTHER
}

enum ElectionStatus {
  DRAFT
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum AuditAction {
  USER_REGISTER
  USER_LOGIN
  LOGIN_FAILED
  USER_LOGOUT
  USER_APPROVED
  USER_SUSPENDED
  ELECTION_CREATED
  ELECTION_UPDATED
  ELECTION_LAUNCHED
  ELECTION_PAUSED
  ELECTION_ENDED
  VOTE_CAST
  CANDIDATE_APPROVED
  CANDIDATE_REJECTED
  PARTY_CREATED
  SETTINGS_CHANGED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  role         Role     @default(VOTER)
  isVerified   Boolean  @default(false)
  isApproved   Boolean  @default(false)
  isSuspended  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adminId      String?
  admin        User?        @relation("AdminUsers", fields: [adminId], references: [id])
  managedUsers User[]       @relation("AdminUsers")

  managedParties   Party[]    @relation("AdminParties")
  managedElections Election[] @relation("AdminElections")

  candidate  Candidate?
  partyAdmin PartyAdmin?
  votes      Vote[]
  auditLogs  AuditLog[]
  otpCodes   OtpCode[]
  enrolledElections Election[] @relation("ElectionVoters")

  @@map("users")
}

model Party {
  id           String   @id @default(cuid())
  name         String   @unique
  abbreviation String?  @unique
  symbol       String?
  color        String?
  description  String?
  manifesto    String?
  website      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adminId      String?
  admin        User?    @relation("AdminParties", fields: [adminId], references: [id])

  candidates  Candidate[]
  partyAdmins PartyAdmin[]

  @@map("parties")
}

model Candidate {
  id         String   @id @default(cuid())
  userId     String   @unique
  partyId    String?
  bio        String?
  manifesto  String?
  assetDecl  Json?
  photoUrl   String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  party       Party?              @relation(fields: [partyId], references: [id])
  nominations ElectionCandidate[]

  @@map("candidates")
}

model PartyAdmin {
  id      String @id @default(cuid())
  userId  String @unique
  partyId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  party Party @relation(fields: [partyId], references: [id])

  @@map("party_admins")
}

model Election {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        ElectionType
  status      ElectionStatus @default(DRAFT)
  startDate   DateTime
  endDate     DateTime
  settings    Json?
  totalVoters Int            @default(0)
  searchCode  String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  adminId        String?
  admin          User?               @relation("AdminElections", fields: [adminId], references: [id])

  candidates ElectionCandidate[]
  votes      Vote[]
  enrolledVoters User[] @relation("ElectionVoters")

  @@map("elections")
}

model ElectionCandidate {
  id          String @id @default(cuid())
  electionId  String
  candidateId String

  election  Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id])
  votes     Vote[]

  @@unique([electionId, candidateId])
  @@map("election_candidates")
}

model Vote {
  id                  String   @id @default(cuid())
  voterId             String
  electionId          String
  electionCandidateId String
  castAt              DateTime @default(now())
  receiptHash         String?  @unique

  voter             User              @relation(fields: [voterId], references: [id])
  election          Election          @relation(fields: [electionId], references: [id])
  electionCandidate ElectionCandidate @relation(fields: [electionCandidateId], references: [id])

  @@unique([voterId, electionId])
  @@map("votes")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
