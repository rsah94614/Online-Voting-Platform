// prisma/schema.prisma
// VOTEX — Full Database Schema
// Prisma 7: datasource block removed — connection is in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  VOTER
  CANDIDATE
  PARTY_ADMIN
}

enum ElectionStatus {
  DRAFT
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum ElectionType {
  PRESIDENTIAL
  PARLIAMENTARY
  MUNICIPAL
  UNIVERSITY
  CORPORATE
  REFERENDUM
  BY_ELECTION
}

enum VotingMethod {
  FPTP
  RANKED_CHOICE
  APPROVAL
  PROPORTIONAL
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PartyStatus {
  ACTIVE
  SUSPENDED
  DISSOLVED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  role        Role      @default(VOTER)
  avatarUrl   String?
  phone       String?
  dateOfBirth DateTime?
  nationality String?
  nationalId  String?   @unique
  address     String?
  isVerified  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions           Session[]
  otpCodes           OtpCode[]
  candidateProfiles  CandidateProfile[]
  voterRegistrations VoterRegistration[]
  votes              Vote[]
  partyMemberships   PartyMember[]
  electionsCreated   Election[]          @relation("ElectionCreator")
  auditLogs          AuditLog[]

  @@index([email])
  @@index([role])
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ─────────────────────────────────────────────
// PARTY
// ─────────────────────────────────────────────

model Party {
  id           String      @id @default(cuid())
  name         String      @unique
  abbreviation String      @unique
  color        String      @default("#00d4ff")
  logoUrl      String?
  bannerUrl    String?
  description  String?
  ideology     String[]
  foundedYear  Int?
  website      String?
  headquarters String?
  status       PartyStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  members    PartyMember[]
  candidates CandidateProfile[]

  @@index([status])
}

model PartyMember {
  id       String   @id @default(cuid())
  userId   String
  partyId  String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([userId, partyId])
}

// ─────────────────────────────────────────────
// ELECTION
// ─────────────────────────────────────────────

model Election {
  id                   String         @id @default(cuid())
  title                String
  description          String?
  type                 ElectionType   @default(PRESIDENTIAL)
  status               ElectionStatus @default(DRAFT)
  votingMethod         VotingMethod   @default(FPTP)
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  launchedAt           DateTime?
  endedAt              DateTime?
  anonymizeVoters      Boolean        @default(true)
  allowSpoiledBallots  Boolean        @default(false)
  requireVerification  Boolean        @default(true)
  maxVoters            Int?
  minCandidates        Int?           @default(2)
  bannerUrl            String?
  rules                String?
  createdById          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  createdBy          User                @relation("ElectionCreator", fields: [createdById], references: [id])
  candidates         CandidateProfile[]
  voterRegistrations VoterRegistration[]
  votes              Vote[]
  constituencies     Constituency[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([startDate, endDate])
}

// ─────────────────────────────────────────────
// CONSTITUENCY
// ─────────────────────────────────────────────

model Constituency {
  id          String   @id @default(cuid())
  electionId  String
  name        String
  code        String?
  region      String?
  totalVoters Int?
  createdAt   DateTime @default(now())

  election   Election           @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates CandidateProfile[]

  @@unique([electionId, name])
}

// ─────────────────────────────────────────────
// CANDIDATE PROFILE
// ─────────────────────────────────────────────

model CandidateProfile {
  id             String          @id @default(cuid())
  userId         String
  electionId     String
  partyId        String?
  constituencyId String?
  status         CandidateStatus @default(PENDING)
  biography      String?
  photoUrl       String?
  education      String?
  achievements   String[]
  keyPolicies    String?
  manifesto      String?
  assetDeclarations String?
  socialLinks    String?
  constituency   String?
  approvedAt     DateTime?
  approvedById   String?
  rejectionNote  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  election        Election      @relation(fields: [electionId], references: [id], onDelete: Cascade)
  party           Party?        @relation(fields: [partyId], references: [id])
  constituencyRel Constituency? @relation(fields: [constituencyId], references: [id])
  votes           Vote[]

  @@unique([userId, electionId])
  @@index([electionId, status])
}

// ─────────────────────────────────────────────
// VOTER REGISTRATION
// ─────────────────────────────────────────────

model VoterRegistration {
  id           String    @id @default(cuid())
  userId       String
  electionId   String
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  registeredAt DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([userId, electionId])
  @@index([electionId])
}

// ─────────────────────────────────────────────
// VOTE
// ─────────────────────────────────────────────

model Vote {
  id          String   @id @default(cuid())
  electionId  String
  candidateId String
  voterId     String
  receipt     String   @unique
  rank        Int?     @default(1)
  castedAt    DateTime @default(now())

  election  Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voter     User             @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([voterId, electionId])
  @@index([electionId, candidateId])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  electionId String?
  action     String
  entity     String?
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  election Election? @relation(fields: [electionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([electionId])
  @@index([action])
  @@index([createdAt])
}
